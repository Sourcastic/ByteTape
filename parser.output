Terminals unused in grammar

    "bad section marker"


Grammar

    0 $accept: program $end

    1 program: "%% tapes" tape_decls "%% states" state_defs

    2 tape_decls: ε
    3           | tape_decls tape_decl

    4 tape_decl: IDENT ':' '{' init_list_opt '}'

    5 init_list_opt: ε
    6              | init_list

    7 init_list: NUMBER
    8          | init_list ',' NUMBER

    9 state_defs: ε
   10           | state_defs state_def

   11 state_def: STATE IDENT block
   12          | START STATE IDENT block

   13 stmt_list: ε
   14          | stmt_list stmt

   15 block: '{' stmt_list '}'

   16 stmt: WRITE cell_ref operand
   17     | MOVE IDENT dir
   18     | INC cell_ref
   19     | DEC cell_ref
   20     | PRINT cell_ref
   21     | PRINTN cell_ref
   22     | INPUT cell_ref
   23     | TRANSITION IDENT
   24     | HALT
   25     | KW_ACCEPT
   26     | KW_REJECT
   27     | if_stmt
   28     | on_stmt

   29 dir: LEFT
   30    | RIGHT

   31 if_stmt: IF cond block
   32        | IF cond block ELSE block
   33        | IF cond block ELSE if_stmt

   34 on_stmt: ON cell_list '{' row_list '}'

   35 cell_list: cell_ref
   36          | cell_list ',' cell_ref

   37 row_list: row
   38         | row_list row

   39 row: pattern_list ARROW block

   40 pattern_list: pattern
   41             | pattern_list ',' pattern

   42 pattern: NUMBER
   43        | '*'

   44 cell_ref: '[' IDENT ']'
   45         | '[' IDENT '+' NUMBER ']'
   46         | '[' IDENT '-' NUMBER ']'

   47 operand: NUMBER
   48        | cell_ref

   49 cond: operand relop operand
   50     | cond AND cond
   51     | cond OR cond
   52     | NOT cond
   53     | '(' cond ')'

   54 relop: EQ
   55      | NE
   56      | '<'
   57      | '>'
   58      | LE
   59      | GE


