/*
 * lexer.l -- turns ByteTape source text into tokens.
 *
 * Generated into lex.yy.c by flex. Token numbers come from parser.tab.h
 * (generated by bison from parser.y).
 *
 *   # comment                     from # to the end of the line
 *   %% tapes   /   %% states      section markers
 *   _                             the blank symbol (the number 0)
 */
%option noyywrap noinput nounput yylineno

%{
#include <limits.h>
#include <stdlib.h>
#include <string.h>
#include "parser.tab.h"
%}

ID      [A-Za-z_][A-Za-z0-9_]*

%%

"#".*                   { /* comment */ }
[ \t\r\n]+              { /* whitespace (yylineno counts the newlines) */ }

"%%"[ \t]*"tapes"       { return SEC_TAPES; }
"%%"[ \t]*"states"      { return SEC_STATES; }
"%%"                    { return BAD_SECTION; }

"state"                 { return STATE; }
"start"                 { return START; }
"transition"            { return TRANSITION; }
"halt"                  { return HALT; }
"accept"                { return KW_ACCEPT; }
"reject"                { return KW_REJECT; }
"write"                 { return WRITE; }
"move"                  { return MOVE; }
"inc"                   { return INC; }
"dec"                   { return DEC; }
"if"                    { return IF; }
"else"                  { return ELSE; }
"on"                    { return ON; }
"and"                   { return AND; }
"or"                    { return OR; }
"not"                   { return NOT; }
"print"                 { return PRINT; }
"printn"                { return PRINTN; }
"input"                 { return INPUT; }
"L"                     { return LEFT; }
"R"                     { return RIGHT; }

"->"                    { return ARROW; }
"=="                    { return EQ; }
"!="                    { return NE; }
"<="                    { return LE; }
">="                    { return GE; }

"_"                     { yylval.num = 0; return NUMBER; }     /* blank */

[0-9]+                  {
                            long v = strtol(yytext, NULL, 10);
                            yylval.num = v > INT_MAX ? INT_MAX : (int)v;
                            return NUMBER;
                        }

 /* character literals: 'a'  and the escapes \n \t \r \0 \\ \' */
"'\\n'"                 { yylval.num = 10; return NUMBER; }
"'\\t'"                 { yylval.num = 9;  return NUMBER; }
"'\\r'"                 { yylval.num = 13; return NUMBER; }
"'\\0'"                 { yylval.num = 0;  return NUMBER; }
"'\\\\'"                { yylval.num = 92; return NUMBER; }
"'\\''"                 { yylval.num = 39; return NUMBER; }
"'"[^'\\\n]"'"          { yylval.num = (unsigned char)yytext[1]; return NUMBER; }

{ID}                    { yylval.str = strdup(yytext); return IDENT; }

.                       { return yytext[0]; }   /* [ ] { } : , + - * < > ( ) -- or an error */

%%
