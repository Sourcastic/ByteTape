# Decides whether a word over {a, b} is a palindrome. The word ends with '$'.
# Change the letters below to test other words.  Prints ACCEPT or REJECT.

%% tapes
Input: {'a', 'b', 'b', 'a', '$'}
Rev:   {}

%% states
# Copy Input onto Rev backwards: Rev is written right-to-left.
state Copy {
    on [Input] {
        '$' -> { move Rev R            # Rev now reads left-to-right as the reversed word
                 transition Rewind }
        *   -> { write [Rev] [Input]
                 move Rev L
                 move Input R
                 transition Copy }
    }
}

# Walk Input back to the blank cell left of the word, then step onto the first letter.
state Rewind {
    on [Input] {
        _ -> { move Input R  transition Compare }
        * -> { move Input L  transition Rewind }
    }
}

# A true two-tape rule table: one row per pair of symbols under the heads.
state Compare {
    on [Input], [Rev] {
        '$', *   -> { accept }
        'a', 'a' -> { move Input R  move Rev R  transition Compare }
        'b', 'b' -> { move Input R  move Rev R  transition Compare }
        *,   *   -> { reject }
    }
}
