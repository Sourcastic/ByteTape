# Decides whether a word over {a, b} is a palindrome. Prints ACCEPT or REJECT.
# Change the letters on the Input tape to test other words.
#
# A two-tape Turing machine: every state is one rule table over BOTH tapes, so it passes --strict.
#
#   Copy     copy the word onto Rev (both heads move right)
#   Rewind   move the Input head back to the first letter; Rev stays on the last letter
#   Compare  read Input forwards and Rev backwards; every pair must match

%% alphabet
input: {'a', 'b'}

%% tapes
Input: {'a', 'b', 'b', 'a'}
Rev:   {}

%% states
state Copy {
    on [Input], [Rev] {
        'a', _ -> { write [Rev] 'a'  move Input R  move Rev R  transition Copy }
        'b', _ -> { write [Rev] 'b'  move Input R  move Rev R  transition Copy }
        _,   _ -> { move Input L  move Rev L  transition Rewind }   # end of the word
        *,   * -> { reject }
    }
}

state Rewind {
    on [Input], [Rev] {
        'a', * -> { move Input L  transition Rewind }
        'b', * -> { move Input L  transition Rewind }
        _,   * -> { move Input R  transition Compare }              # blank left of the word
    }
}

state Compare {
    on [Input], [Rev] {
        'a', 'a' -> { move Input R  move Rev L  transition Compare }
        'b', 'b' -> { move Input R  move Rev L  transition Compare }
        _,   _   -> { accept }                                      # both tapes used up together
        *,   *   -> { reject }
    }
}
