# Adds 1 to a binary number stored least-significant bit first.
# '1' '1' '0' '1' (LSB first) is 11, so the result is 12 = '0' '0' '1' '1' (LSB first).
#
# A one-tape Turing machine: one rule table, one row per symbol, so it passes --strict.

%% alphabet
input: {'0', '1'}

%% tapes
Bits: {'1', '1', '0', '1'}

%% states
state Inc {
    on [Bits] {
        '1' -> { write [Bits] '0'  move Bits R  transition Inc }   # 1 + 1 = 0, carry on
        '0' -> { write [Bits] '1'  halt }                          # 0 + 1 = 1, done
        _   -> { write [Bits] '1'  halt }                          # past the end: the number grows
    }
}
